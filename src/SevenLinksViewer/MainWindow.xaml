<Window x:Class="SevenLinksViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="7links Camera Viewer" Height="720" Width="1180"
        Background="#1E1E1E" Foreground="#EEE">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEE"/>
        </Style>

        <CollectionViewSource x:Key="ClipsView">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DayLabel"/>
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="StartUtc" Direction="Descending"
                                                xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenButton" Content="Open Camera Folder..." Click="OpenButton_Click"/>
                <Button x:Name="ExportButton" Content="Export Current Clip..." Click="ExportButton_Click" IsEnabled="False"/>
                <Button x:Name="RefreshButton" Content="Clear Cache &amp; Reload" Click="RefreshButton_Click" IsEnabled="False"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Text="No folder loaded."/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Single list of clips, grouped by day -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Clips" FontWeight="Bold" Margin="8,8,8,4"/>
                <ListBox x:Name="ClipList" Margin="4"
                         SelectionChanged="ClipList_SelectionChanged"
                         ItemsSource="{Binding Source={StaticResource ClipsView}}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TimeLabel}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DetailLabel}" FontSize="11" Foreground="#AAA"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="X" Width="24" Padding="0" Margin="6,0,0,0"
                                        ToolTip="Delete this event folder from disk"
                                        Click="DeleteClipButton_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#37373D" Padding="8,4" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFD200"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3C3C3C"/>

            <!-- Right side: video + transport -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="44"/>
                </Grid.RowDefinitions>

                <!-- Video -->
                <Border Grid.Row="0" Background="Black" Margin="4">
                    <vlc:VideoView x:Name="VideoView"/>
                </Border>

                <!-- Transport controls -->
                <DockPanel Grid.Row="1" Margin="4,0,4,4">
                    <Button DockPanel.Dock="Left" x:Name="PlayPauseButton" Content="Play/Pause"
                            Click="PlayPauseButton_Click" IsEnabled="False"/>
                    <Button DockPanel.Dock="Left" x:Name="StopButton" Content="Stop"
                            Click="StopButton_Click" IsEnabled="False"/>
                    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0" Text="--:-- / --:--"/>
                    <Slider x:Name="SeekSlider" VerticalAlignment="Center" Minimum="0" Maximum="1000"
                            Thumb.DragStarted="SeekSlider_DragStarted"
                            Thumb.DragCompleted="SeekSlider_DragCompleted"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
